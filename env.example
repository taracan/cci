# AWS Configuration (optional - for AWS Secret Manager)
# Set these to use AWS Secret Manager instead of environment variables
# AWS_SECRET_NAME=resume-jd-portal/config
# AWS_REGION=us-east-1

# Application Secrets
SECRET_KEY=your-secret-key-change-in-production
ADMIN_KEY=your-admin-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/database_name

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.2:latest
LLM_TIMEOUT_SECS=120
LLM_TEMPERATURE=0.2

# Matching Pipeline
MATCH_TOP_K=10

# Queue Manager
QUEUE_MAX_CONCURRENT=2
QUEUE_TTL_SECS=180

# Logging / Observability
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_TO_CLOUDWATCH=false
